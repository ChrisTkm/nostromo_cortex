# MongoDB connection URI for the MCP server, CLI scripts, and shared core config.
# Default: mongodb://127.0.0.1:27017
MONGO_URL=mongodb://127.0.0.1:27017

# MongoDB database name used by the MCP server, CLI scripts, and shared core config.
# Default: cortex
# ⚠️  ÚNICA fuente para CLI + MCP server. La extensión VS Code tiene su PROPIO
#     setting `cortex.mongoDbName` en `.vscode/settings.json` que DEBE coincidir.
#     Si divergen, el CLI escribe en una DB y la extensión lee de otra → split-brain
#     (síntoma: colecciones vacías en la DB default mientras los datos están en otra).
MONGO_DB_NAME=cortex

# MongoDB collection name used for Cortex tasks.
# Default: tasks
MONGO_TASKS_COLLECTION=tasks

# Telemetry storage backend. Use "sqlite" or "jsonl".
# Default: sqlite
# ⚠️  DEBE coincidir con `cortex.telemetryBackend` en `.vscode/settings.json`
#     para que las interacciones del extension sean visibles via los scripts inspect.
TELEMETRY_BACKEND=sqlite

# SQLite telemetry database path.
# Default: ./data/telemetry/cortex-telemetry.db
# ⚠️  DEBE coincidir con `cortex.telemetrySqlitePath` en `.vscode/settings.json`
TELEMETRY_SQLITE_PATH=./data/telemetry/cortex-telemetry.db

# JSONL telemetry output path when TELEMETRY_BACKEND=jsonl.
# Default: ./data/telemetry/cortex-telemetry.jsonl
# ⚠️  DEBE coincidir con `cortex.telemetryJsonlPath` en `.vscode/settings.json`
TELEMETRY_JSONL_PATH=./data/telemetry/cortex-telemetry.jsonl

# Logger verbosity. Supported values: debug, info, warn, error.
# Default: info
LOG_LEVEL=info

# Logger output format. Use "pretty" or "json".
# Default: pretty
LOG_FORMAT=pretty

# Maximum number of tasks included in graph snapshots.
# Default: 500
SNAPSHOT_MAX_TASKS=500
