{
  "name": "cortex",
  "displayName": "Cortex",
  "publisher": "cortex-local",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "main": "./dist/extension.cjs",
  "icon": "media/marketplace-icon.png",
  "files": [
    "dist/**",
    "media/**",
    "package.json",
    "LICENSE.txt"
  ],
  "engines": {
    "vscode": "^1.100.0"
  },
  "activationEvents": [
    "onStartupFinished",
    "onView:cortex.overview",
    "onCommand:cortex.openGraph",
    "onCommand:cortex.openArchive",
    "onCommand:cortex.openBrain",
    "onCommand:cortex.openScriptFlow",
    "onCommand:cortex.openScriptFlowForSelection",
    "onCommand:cortex.archivePlan",
    "onCommand:cortex.restorePlan",
    "onCommand:cortex.deleteArchivedPlan",
    "onCommand:cortex.exportArchive",
    "onCommand:cortex.importArchive",
    "onCommand:cortex.setMongoUrl",
    "onCommand:cortex.clearMongoUrl",
    "onCommand:cortex.openLedger",
    "onCommand:cortex.openPlans",
    "onCommand:cortex.openPlanEditor"
  ],
  "contributes": {
    "commands": [
      {
        "command": "cortex.refresh",
        "title": "Cortex: Refresh tasks"
      },
      {
        "command": "cortex.openTasks",
        "title": "Cortex: Focus task navigator"
      },
      {
        "command": "cortex.switchPanel",
        "title": "Cortex: Switch panel"
      },
      {
        "command": "cortex.openGraph",
        "title": "Cortex: Open PERT graph"
      },
      {
        "command": "cortex.togglePlanStatusFilter",
        "title": "Cortex: Toggle plan status filter",
        "icon": "$(filter)"
      },
      {
        "command": "cortex.showOptions",
        "title": "Cortex: Options"
      },
      {
        "command": "cortex.openNotes",
        "title": "Cortex: Open notes panel"
      },
      {
        "command": "cortex.openLogs",
        "title": "Cortex: Open logs panel"
      },
      {
        "command": "cortex.openArchive",
        "title": "Cortex: Open Archive"
      },
      {
        "command": "cortex.openBrain",
        "title": "Cortex: Open Brain"
      },
      {
        "command": "cortex.openScriptFlow",
        "title": "Cortex: Open Script Flow"
      },
      {
        "command": "cortex.openScriptFlowForSelection",
        "title": "Cortex: Open Script Flow for Selection"
      },
      {
        "command": "cortex.newNote",
        "title": "Cortex: New note"
      },
      {
        "command": "cortex.editNote",
        "title": "Cortex: Edit note"
      },
      {
        "command": "cortex.deleteNote",
        "title": "Cortex: Delete note"
      },
      {
        "command": "cortex.snoozeReminder",
        "title": "Cortex: Snooze reminder"
      },
      {
        "command": "cortex.setSearchQuery",
        "title": "Cortex: Set search query"
      },
      {
        "command": "cortex.setTagFilter",
        "title": "Cortex: Set tag filter"
      },
      {
        "command": "cortex.setProjectFilter",
        "title": "Cortex: Set project filter"
      },
      {
        "command": "cortex.setGroupFilter",
        "title": "Cortex: Set group filter"
      },
      {
        "command": "cortex.selectDatabase",
        "title": "Cortex: Select Mongo database"
      },
      {
        "command": "cortex.setMongoUrl",
        "title": "Cortex: Set Mongo URL"
      },
      {
        "command": "cortex.clearMongoUrl",
        "title": "Cortex: Clear Mongo URL"
      },
      {
        "command": "cortex.bootstrapDatabase",
        "title": "Cortex: Create sample local database"
      },
      {
        "command": "cortex.editTask",
        "title": "Cortex: Edit task"
      },
      {
        "command": "cortex.newTask",
        "title": "Cortex: New task",
        "icon": "$(add)"
      },
      {
        "command": "cortex.clearFilters",
        "title": "Cortex: Clear filters"
      },
      {
        "command": "cortex.selectPlan",
        "title": "Cortex: Select Action Plan"
      },
      {
        "command": "cortex.archivePlan",
        "title": "Cortex: Archive Plan"
      },
      {
        "command": "cortex.restorePlan",
        "title": "Cortex: Restore Plan"
      },
      {
        "command": "cortex.deleteArchivedPlan",
        "title": "Cortex: Delete Archived Plan"
      },
      {
        "command": "cortex.exportArchive",
        "title": "Cortex: Export Archive (ZIP)"
      },
      {
        "command": "cortex.importArchive",
        "title": "Cortex: Import Archive (ZIP)"
      },
      {
        "command": "cortex.listCycles",
        "title": "Cortex: List dependency cycles"
      },
      {
        "command": "cortex.markDone",
        "title": "Mark done"
      },
      {
        "command": "cortex.markInProgress",
        "title": "Mark in progress"
      },
      {
        "command": "cortex.markBlocked",
        "title": "Mark blocked"
      },
      {
        "command": "cortex.setAiAgentIcon",
        "title": "Cortex: Set AI Agent icon"
      },
      {
        "command": "cortex.openLedger",
        "title": "Cortex: Open Ledger"
      },
      {
        "command": "cortex.openPlans",
        "title": "Cortex: Open Plans"
      },
      {
        "command": "cortex.openPlanEditor",
        "title": "Cortex: Open Plan Editor"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cortex",
          "title": "Cortex",
          "icon": "media/cortex.svg"
        }
      ]
    },
    "views": {
      "cortex": [
        {
          "id": "cortex.overview",
          "name": "Task Navigator"
        }
      ]
    },
    "keybindings": [
      {
        "command": "cortex.newNote",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n"
      },
      {
        "command": "cortex.openNotes",
        "key": "ctrl+alt+shift+n",
        "mac": "cmd+alt+shift+n"
      },
      {
        "command": "cortex.newTask",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "cortex.refresh",
          "when": "view == cortex.overview",
          "group": "navigation@1"
        },
        {
          "command": "cortex.switchPanel",
          "when": "view == cortex.overview",
          "group": "navigation@2"
        },
        {
          "command": "cortex.togglePlanStatusFilter",
          "when": "view == cortex.overview",
          "group": "navigation@3"
        },
        {
          "command": "cortex.newTask",
          "when": "view == cortex.overview",
          "group": "navigation@4"
        },
        {
          "command": "cortex.showOptions",
          "when": "view == cortex.overview",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "cortex.editTask",
          "when": "view == cortex.overview && viewItem == cortex.task",
          "group": "inline@1"
        },
        {
          "command": "cortex.openGraph",
          "when": "view == cortex.overview && viewItem == cortex.task",
          "group": "inline@2"
        },
        {
          "command": "cortex.markDone",
          "when": "view == cortex.overview && viewItem == cortex.task",
          "group": "1_status@1"
        },
        {
          "command": "cortex.markInProgress",
          "when": "view == cortex.overview && viewItem == cortex.task",
          "group": "1_status@2"
        },
        {
          "command": "cortex.markBlocked",
          "when": "view == cortex.overview && viewItem == cortex.task",
          "group": "1_status@3"
        },
        {
          "command": "cortex.archivePlan",
          "when": "view == cortex.overview && viewItem == cortex.plan.done",
          "group": "inline@1"
        }
      ],
      "editor/context": [
        {
          "command": "cortex.openScriptFlow",
          "when": "editorTextFocus && (resourceExtname == .ts || resourceExtname == .tsx || resourceExtname == .js || resourceExtname == .jsx || resourceExtname == .py || resourceExtname == .sql)",
          "group": "navigation@10"
        },
        {
          "command": "cortex.openScriptFlowForSelection",
          "when": "editorTextFocus && editorHasSelection && (resourceExtname == .ts || resourceExtname == .tsx || resourceExtname == .js || resourceExtname == .jsx || resourceExtname == .py || resourceExtname == .sql)",
          "group": "navigation@11"
        }
      ]
    },
    "configuration": {
      "title": "Cortex",
      "properties": {
        "cortex.mongoUrl": {
          "type": "string",
          "default": "mongodb://127.0.0.1:27017",
          "description": "MongoDB connection string used by the extension host.",
          "deprecationMessage": "Use the 'Cortex: Set Mongo URL' command instead. The URL is now stored securely in VS Code SecretStorage."
        },
        "cortex.mongoDbName": {
          "type": "string",
          "default": "cortex",
          "description": "Mongo database name used for task storage."
        },
        "cortex.mongoTasksCollection": {
          "type": "string",
          "default": "tasks",
          "description": "Mongo collection name used for tasks."
        },
        "cortex.mongoNotesCollection": {
          "type": "string",
          "default": "notes",
          "description": "Colección de notas en Mongo."
        },
        "cortex.mongoLogsCollection": {
          "type": "string",
          "default": "logs",
          "description": "Colección de logs en Mongo."
        },
        "cortex.logsLimit": {
          "type": "number",
          "default": 500,
          "minimum": 50,
          "maximum": 5000,
          "description": "Number of most recent logs fetched from Mongo per refresh. Higher values increase memory and initial latency."
        },
        "cortex.scriptFlowMaxDepth": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 5,
          "description": "Maximum depth for cross-file expansion in Script Flow (0 disables, 5 is the hard cap). Solo TypeScript/JavaScript. Requiere reabrir el panel para tomar efecto."
        },
        "cortex.logsAutoRefreshSeconds": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 600,
          "description": "Auto-refresh interval for the Cortex Logs panel, in seconds. 0 disables it."
        },
        "cortex.logsSource": {
          "type": "string",
          "enum": [
            "mongo",
            "file"
          ],
          "default": "mongo",
          "description": "Where the Cortex Logs panel reads from. 'mongo' queries the MongoDB logs collection (default). 'file' tails a JSONL file written by your app following docs/log-contract.md."
        },
        "cortex.logsFilePath": {
          "type": "string",
          "default": "",
          "description": "JSONL file path used when cortex.logsSource is 'file'. Empty resolves to <workspaceFolder>/logs/cortex.jsonl. Relative paths resolve against the first workspace folder."
        },
        "cortex.logsChangeStreams": {
          "type": "boolean",
          "default": false,
          "description": "Subscribe to MongoDB Change Streams for real-time log updates instead of polling. Requires a replica set or Atlas. On single-node Mongo the extension logs a warning and falls back to polling (cortex.logsAutoRefreshSeconds)."
        },
        "cortex.mongoPlansCollection": {
          "type": "string",
          "default": "action_plans",
          "description": "Colección de action_plans en Mongo"
        },
        "cortex.archivePath": {
          "type": "string",
          "default": "",
          "description": "Archive output directory. If empty, Cortex uses ~/cortex-archive."
        },
        "cortex.brainMaxFiles": {
          "type": "number",
          "default": 800,
          "minimum": 1,
          "description": "Maximum number of .md/.mdx files scanned by Cortex Brain."
        },
        "cortex.brainRootPath": {
          "type": "string",
          "default": "",
          "description": "Default local folder scanned by Cortex Brain. Leave empty to choose a folder when opening the panel."
        },
        "cortex.brainAccountPattern": {
          "type": "string",
          "default": "",
          "description": "Regex (sin delimitadores, capture group con el account id) usado por el panel Brain para extraer 'accounts' desde el body de los .md/.mdx. Empty desactiva la extracción. Ejemplo legacy de jean_d_arc: /manual-cuentas/[^)\\s\"']+/(\\d{4,})/?"
        },
        "cortex.telemetryBackend": {
          "type": "string",
          "enum": [
            "sqlite",
            "jsonl"
          ],
          "default": "sqlite",
          "description": "Telemetry storage backend."
        },
        "cortex.telemetrySqlitePath": {
          "type": "string",
          "default": "./data/telemetry/cortex-telemetry.db",
          "description": "Local SQLite path for telemetry."
        },
        "cortex.defaultAgent": {
          "type": "string",
          "default": "any",
          "description": "Default agent assigned to new tasks created via cortex.newTask (e.g. codex, cursor, human). Falls back to 'any' if empty."
        }
      }
    }
  },
  "scripts": {
    "dev": "node esbuild.mjs --watch",
    "build": "node esbuild.mjs",
    "lint": "eslint src --ext .ts,.tsx",
    "package:vsix": "vsce package --no-dependencies --allow-missing-repository"
  },
  "dependencies": {
    "@cortex/core": "workspace:*",
    "@cortex/telemetry": "workspace:*",
    "@dagrejs/dagre": "^3.0.0",
    "@xyflow/react": "^12.10.2",
    "html-to-image": "^1.11.13",
    "mongodb": "^6.16.0",
    "node-sql-parser": "^5.4.0",
    "jszip": "^3.10.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "web-tree-sitter": "^0.26.8",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.100.0",
    "esbuild": "^0.25.2",
    "tree-sitter-python": "^0.25.0"
  }
}
